{
  "name": "RealEstate Hub - Voice Agent Workflow (Day 4 Task 4)",
  "meta": {
    "instanceId": "real-estate-voice-agent"
  },
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "webhook-call-start",
      "name": "Telephony Trigger (Call Start)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1180, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-agent/call-start",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "http-call-start",
      "name": "POST /webhook/call-start",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-940, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VOICE_AGENT_API_BASE }}/webhook/call-start",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session_id\": $json.body.session_id, \"client_phone\": $json.body.client_phone } }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "webhook-transcript",
      "name": "Deepgram Transcript Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1180, 520],
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-agent/transcript",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "http-intent",
      "name": "POST /intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-940, 520],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VOICE_AGENT_API_BASE }}/intent",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session_id\": $json.body.session_id, \"customer_text\": $json.body.customer_text } }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "if-intent-ok",
      "name": "Intent OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-700, 520],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "http-property-match",
      "name": "POST /property-match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-460, 460],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VOICE_AGENT_API_BASE }}/property-match",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session_id\": $json.session_id } }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "switch-appointment-intent",
      "name": "Route by appointment_intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [-220, 520],
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [ { "leftValue": "={{ $('POST /intent').item.json.appointment_intent }}", "rightValue": "book", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "book" },
            { "conditions": { "conditions": [ { "leftValue": "={{ $('POST /intent').item.json.appointment_intent }}", "rightValue": "reschedule", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "reschedule" },
            { "conditions": { "conditions": [ { "leftValue": "={{ $('POST /intent').item.json.appointment_intent }}", "rightValue": "cancel", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "cancel" }
          ]
        },
        "fallbackOutput": "extra",
        "options": {}
      }
    },
    {
      "id": "http-appointment-prepare",
      "name": "POST /appointment/prepare",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VOICE_AGENT_API_BASE }}/appointment/prepare",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session_id\": $('POST /intent').item.json.session_id, \"customer_text\": $('POST /intent').item.json.customer_text } }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },

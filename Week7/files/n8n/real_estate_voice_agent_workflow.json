        "options": { "response": { "response": { "neverError": true } } }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "id": "http-reschedule",
      "name": "POST /calendar/reschedule",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 520],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VOICE_AGENT_API_BASE }}/calendar/reschedule",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session_id\": $('POST /intent').item.json.session_id, \"event_id\": $json.pending_appointment_event_id, \"new_datetime_text\": $('POST /intent').item.json.customer_text } }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "id": "if-reschedule-ok",
      "name": "Reschedule OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [280, 520],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.success }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "http-email-reschedule",
      "name": "POST /email/notify (reschedule)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 460],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VOICE_AGENT_API_BASE }}/email/notify",

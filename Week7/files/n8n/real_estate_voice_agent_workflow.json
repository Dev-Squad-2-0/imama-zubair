      "parameters": {
        "method": "POST",
        "url": "={{ $env.VOICE_AGENT_API_BASE }}/crm/log",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session_id\": $('POST /intent').item.json.session_id, \"event_type\": \"workflow_completed\", \"status\": \"success\", \"payload\": $json } }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "crm-log-failure",
      "name": "POST /crm/log (workflow_failed)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 900],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VOICE_AGENT_API_BASE }}/crm/log",

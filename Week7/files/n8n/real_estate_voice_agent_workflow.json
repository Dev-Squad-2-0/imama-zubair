      "main": [[{ "node": "POST /intent", "type": "main", "index": 0 }]]
    },
    "POST /intent": {
      "main": [[{ "node": "Intent OK?", "type": "main", "index": 0 }]]
    },
    "Intent OK?": {
      "main": [
        [{ "node": "POST /property-match", "type": "main", "index": 0 }],
        [{ "node": "POST /crm/log (workflow_failed)", "type": "main", "index": 0 }]
      ]
    },
    "POST /property-match": {
      "main": [[{ "node": "Route by appointment_intent", "type": "main", "index": 0 }]]
    },
    "Route by appointment_intent": {
      "main": [
        [{ "node": "POST /appointment/prepare", "type": "main", "index": 0 }],
        [{ "node": "POST /calendar/reschedule", "type": "main", "index": 0 }],
        [{ "node": "POST /calendar/cancel", "type": "main", "index": 0 }],
        [{ "node": "No Booking Intent This Turn", "type": "main", "index": 0 }]
      ]
    },
    "POST /appointment/prepare": {
      "main": [[{ "node": "Ready to Book?", "type": "main", "index": 0 }]]
    },
    "Ready to Book?": {
      "main": [
        [{ "node": "POST /calendar/create", "type": "main", "index": 0 }],
        [{ "node": "POST /crm/log (workflow_failed)", "type": "main", "index": 0 }]
      ]
    },
    "POST /calendar/create": {
      "main": [[{ "node": "Calendar OK?", "type": "main", "index": 0 }]]
    },
    "Calendar OK?": {
      "main": [
        [{ "node": "POST /email/notify (book)", "type": "main", "index": 0 }],
        [{ "node": "POST /crm/log (workflow_failed)", "type": "main", "index": 0 }]
      ]
    },
    "POST /email/notify (book)": {
      "main": [[{ "node": "POST /crm/log (workflow_completed)", "type": "main", "index": 0 }]]
    },
    "POST /calendar/reschedule": {
      "main": [[{ "node": "Reschedule OK?", "type": "main", "index": 0 }]]
    },
    "Reschedule OK?": {
      "main": [
        [{ "node": "POST /email/notify (reschedule)", "type": "main", "index": 0 }],
        [{ "node": "POST /crm/log (workflow_failed)", "type": "main", "index": 0 }]
      ]
    },
    "POST /email/notify (reschedule)": {
      "main": [[{ "node": "POST /crm/log (workflow_completed)", "type": "main", "index": 0 }]]
    },
    "POST /calendar/cancel": {
      "main": [[{ "node": "Cancel OK?", "type": "main", "index": 0 }]]
    },
    "Cancel OK?": {
      "main": [
        [{ "node": "POST /email/notify (cancel)", "type": "main", "index": 0 }],

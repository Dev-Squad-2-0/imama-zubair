        "jsonBody": "={{ { \"session_id\": $('POST /intent').item.json.session_id, \"kind\": \"cancel\", \"appointment\": $('POST /appointment/prepare').item.json.appointment, \"reason\": $('POST /intent').item.json.customer_text } }}",
        "options": { "response": { "response": { "neverError": true } } }

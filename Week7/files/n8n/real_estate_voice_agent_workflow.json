        "jsonBody": "={{ { \"session_id\": $('POST /intent').item.json.session_id, \"kind\": \"reschedule\", \"appointment\": $('POST /calendar/reschedule').item.json, \"old_start_datetime\": $('POST /calendar/reschedule').item.json.old_start_datetime } }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "id": "http-cancel",
      "name": "POST /calendar/cancel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
